generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── CURRICULUM STRUCTURE ────────────────────────────

model Domain {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String
  icon          String
  color         String         // Hex color e.g. #3B82F6
  sortOrder     Int
  tracks        Track[]
  skills        Skill[]
  studySessions StudySession[]
  createdAt     DateTime       @default(now())
}

model Track {
  id          String   @id @default(cuid())
  domainId    String
  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  description String
  sortOrder   Int
  startMonth  Int      // Month 1-24 when this track begins
  endMonth    Int      // Month 1-24 when this track should complete
  modules     Module[]
  createdAt   DateTime @default(now())

  @@index([domainId])
}

model Module {
  id             String    @id @default(cuid())
  trackId        String
  track          Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  name           String
  slug           String    @unique
  description    String
  difficulty     String    @default("FOUNDATIONAL") // INTRODUCTORY|FOUNDATIONAL|INTERMEDIATE|ADVANCED|EXPERT
  sortOrder      Int
  estimatedHours Float
  units          Unit[]
  projects       Project[]
  createdAt      DateTime  @default(now())

  @@index([trackId])
}

model Unit {
  id               String   @id @default(cuid())
  moduleId         String
  module           Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name             String
  slug             String   @unique
  description      String
  sortOrder        Int
  estimatedMinutes Int
  lessons          Lesson[]
  createdAt        DateTime @default(now())

  @@index([moduleId])
}

model Lesson {
  id               String       @id @default(cuid())
  unitId           String
  unit             Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title            String
  slug             String       @unique
  content          String       // Markdown
  contentFormat    String       @default("MARKDOWN") // MARKDOWN|VIDEO_URL|INTERACTIVE
  sortOrder        Int
  estimatedMinutes Int
  exercises        Exercise[]
  submissions      Submission[]
  reviewItems      ReviewItem[]
  lessonSkills     LessonSkill[]
  createdAt        DateTime     @default(now())

  @@index([unitId])
}

// ─── JUNCTION: Lesson <-> Skill ─────────────────────

model LessonSkill {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([lessonId, skillId])
  @@index([skillId])
}

model Exercise {
  id            String    @id @default(cuid())
  lessonId      String
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type          String    @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE|TRUE_FALSE|SHORT_ANSWER|CODE_CHALLENGE
  question      String
  options       String?   // JSON array for MC/TF
  correctAnswer String    // JSON
  explanation   String
  difficulty    String    @default("FOUNDATIONAL")
  sortOrder     Int
  skillId       String?
  skill         Skill?    @relation(fields: [skillId], references: [id])
  attempts      Attempt[]
  createdAt     DateTime  @default(now())

  @@index([lessonId])
  @@index([skillId])
}

// ─── PROJECTS ────────────────────────────────────────

model Project {
  id             String             @id @default(cuid())
  moduleId       String
  module         Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name           String
  slug           String             @unique
  description    String
  difficulty     String             @default("FOUNDATIONAL")
  estimatedHours Float
  isCapstone     Boolean            @default(false)
  milestones     ProjectMilestone[]
  projectSkills  ProjectSkill[]
  createdAt      DateTime           @default(now())

  @@index([moduleId])
}

// ─── JUNCTION: Project <-> Skill ────────────────────

model ProjectSkill {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
  @@index([skillId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String
  sortOrder   Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([projectId])
}

// ─── SKILLS & DEPENDENCIES ──────────────────────────

model Skill {
  id            String            @id @default(cuid())
  domainId      String
  domain        Domain            @relation(fields: [domainId], references: [id], onDelete: Cascade)
  name          String
  slug          String            @unique
  description   String
  category      String
  dependsOn     SkillDependency[] @relation("DependentSkill")
  dependedOnBy  SkillDependency[] @relation("PrerequisiteSkill")
  masteryRecord MasteryRecord?
  exercises     Exercise[]
  lessonSkills  LessonSkill[]
  projectSkills ProjectSkill[]
  createdAt     DateTime          @default(now())

  @@index([domainId])
}

model SkillDependency {
  id              String @id @default(cuid())
  dependentId     String
  dependent       Skill  @relation("DependentSkill", fields: [dependentId], references: [id], onDelete: Cascade)
  prerequisiteId  String
  prerequisite    Skill  @relation("PrerequisiteSkill", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  minMasteryLevel Int    @default(2)

  @@unique([dependentId, prerequisiteId])
  @@index([prerequisiteId])
}

// ─── LEARNER PROGRESS ───────────────────────────────

model MasteryRecord {
  id              String    @id @default(cuid())
  skillId         String    @unique
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level           Int       @default(0) // 0-5: Unseen, Exposed, Shaky, Usable, Strong, Mastered
  confidence      Float     @default(0.5) // 0.0-1.0 Bayesian confidence
  totalAttempts   Int       @default(0)
  correctAttempts Int       @default(0)
  lastPracticed   DateTime?
  lastLevelChange DateTime?
  streakCorrect   Int       @default(0)
  streakWrong     Int       @default(0)
  velocity        Float     @default(0) // rate of mastery change, positive = improving
  updatedAt       DateTime  @updatedAt
}

model ReviewItem {
  id         String    @id @default(cuid())
  lessonId   String?
  lesson     Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  skillId    String
  question   String
  answer     String
  interval   Float     @default(1)    // Days until next review
  repetition Int       @default(0)    // Consecutive correct count
  efactor    Float     @default(2.5)  // Easiness factor >= 1.3
  nextReview DateTime
  lastReview DateTime?
  resetCount Int       @default(0)    // Times reset (leech detection)
  createdAt  DateTime  @default(now())

  @@index([nextReview])
  @@index([skillId])
}

model Submission {
  id          String    @id @default(cuid())
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  score       Float?    // 0.0-1.0
  timeSpentMs Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([lessonId])
}

model Attempt {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  answer      String   // JSON
  correct     Boolean
  timeSpentMs Int      @default(0)
  hints       Int      @default(0)
  confidence  Int      @default(3) // 1-5 self-reported
  createdAt   DateTime @default(now())

  @@index([exerciseId])
}

// ─── DAILY PLANNING ─────────────────────────────────

model DailyPlan {
  id            String         @id @default(cuid())
  date          String         @unique // YYYY-MM-DD
  items         DailyPlanItem[]
  totalMinutes  Int
  actualMinutes Int?
  completed     Boolean        @default(false)
  createdAt     DateTime       @default(now())
}

model DailyPlanItem {
  id               String    @id @default(cuid())
  planId           String
  plan             DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  type             String    // LESSON|REVIEW|PROJECT|EXERCISE|REFLECTION
  referenceId      String
  title            String
  description      String?
  estimatedMinutes Int
  sortOrder        Int
  status           String    @default("PENDING") // PENDING|IN_PROGRESS|COMPLETED|SKIPPED
  reason           String?   // Why this item was assigned
  completedAt      DateTime?

  @@index([planId])
}

// ─── STUDY SESSIONS & STREAKS ───────────────────────

model StudySession {
  id               String    @id @default(cuid())
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  domainId         String?
  domain           Domain?   @relation(fields: [domainId], references: [id], onDelete: SetNull)
  totalMinutes     Int       @default(0)
  lessonsCompleted Int       @default(0)
  reviewsDone      Int       @default(0)
  exercisesDone    Int       @default(0)

  @@index([domainId])
  @@index([startedAt])
}

model Streak {
  id              String   @id @default(cuid())
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDate  String?  // YYYY-MM-DD
  totalDaysActive Int      @default(0)
  updatedAt       DateTime @updatedAt
}

// ─── REFLECTION & FOUNDER ───────────────────────────

model ReflectionEntry {
  id           String        @id @default(cuid())
  date         String        // YYYY-MM-DD
  mood         Int?          // 1-5
  content      String
  whatWentWell String?
  whatWasHard  String?
  whatILearned String?
  tags         String?       // CSV
  promptId     String?
  prompt       FounderPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([date])
}

model FounderPrompt {
  id          String            @id @default(cuid())
  weekNumber  Int               @unique
  prompt      String
  category    String            // vision|risk|market|team|product|growth
  description String
  sortOrder   Int
  reflections ReflectionEntry[]
}

// ─── USER PREFERENCES ───────────────────────────────

model UserSettings {
  id                 String  @id @default(cuid())
  displayName        String  @default("Learner")
  dailyGoalMinutes   Int     @default(90)
  preferredStartTime String  @default("09:00")
  weekendMode        Boolean @default(false)
  theme              String  @default("dark")
  currentMonth       Int     @default(1) // 1-24
  onboardingComplete Boolean @default(false)
}
